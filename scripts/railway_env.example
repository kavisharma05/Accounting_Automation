# Paste into Railway project variables (API + Worker services).
# Reference Postgres/Redis from the Railway dashboard using:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}

SECRET_KEY=generate-with-openssl-rand-hex-32
ENVIRONMENT=staging
RUN_MIGRATIONS=true
SERVE_FRONTEND=true

MESSAGING_PROVIDER=mock
DOCUMENT_PROVIDER=mock
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/tmp/documents

# Persistent storage — S3 / Cloudflare R2 (uncomment for production)
# STORAGE_PROVIDER=s3
# S3_BUCKET=your-bucket-name
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
GSP_PROVIDER=mock

# Document AI — NVIDIA Integrate (OpenAI-compatible)
# DOCUMENT_PROVIDER=nvidia
# DOCUMENT_AI_API_KEY=
# DOCUMENT_AI_BASE_URL=https://integrate.api.nvidia.com/v1
# DOCUMENT_AI_MODEL=meta/llama-3.2-11b-vision-instruct

# Set after first deploy — use your Railway public domain:
# CORS_ORIGINS=https://your-api.up.railway.app
