# Copy to .env.staging and fill in before staging deploy:
#   cp .env.staging.example .env.staging
#   openssl rand -hex 32   # paste as SECRET_KEY

SECRET_KEY=replace-with-openssl-rand-hex-32

DATABASE_URL=postgresql+psycopg2://accounting:accounting@db:5432/accounting
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=staging
RUN_MIGRATIONS=true

MESSAGING_PROVIDER=mock
DOCUMENT_PROVIDER=mock
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/documents

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SERVE_FRONTEND=true

WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# Optional — enable for staging pilot with real adapters
# ANTHROPIC_API_KEY=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
