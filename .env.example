# Copy to .env and fill in for production pilot

DATABASE_URL=postgresql+psycopg2://accounting:accounting@localhost:5432/accounting
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-random-64-char-string

# Providers: mock | whatsapp | claude
MESSAGING_PROVIDER=mock
DOCUMENT_PROVIDER=mock
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/documents

# Production AI
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (production)
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# S3 / Cloudflare R2 (production)
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GSP sandbox
GSP_PROVIDER=mock

# Dashboard UI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=true
